cabal-version: 2.2
name: my-game-project
version: 0.1.0.0
build-type: Simple
extra-source-files: README.md

library
  hs-source-dirs: src
  exposed-modules: Types
                 , Map
                 , Movement
                 , Player
                 , Input
                 , Trail
                 , Territory
                 , Items
                 , Game
                 , UI
                 , GameLoop
  build-depends: base >= 4.7 && < 5, vector, containers
  default-language: Haskell2010

executable my-game-project-exe
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base >= 4.7 && < 5
               , my-game-project
  default-language: Haskell2010

test-suite my-game-project-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: base >= 4.7 && < 5
               , my-game-project
               , hspec
  default-language: Haskell2010
