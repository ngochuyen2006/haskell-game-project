cabal-version: 2.2
name: my-game-project
version: 0.1.0.0
build-type: Simple
extra-source-files: README.md

flag gui
  description: Build the graphical (gloss) version. Disable with --flag my-game-project:-gui if gloss fails to install.
  default: True
  manual: True

library
  hs-source-dirs: src
  exposed-modules: Types
                  , Map
                  , Movement
                  , Player
                  , Input
                  , Trail
                  , Territory
                  , Items
                  , Game
                  , UI
                  , GameLoop
                  , Collision
  build-depends: base >= 4.7 && < 5, vector, containers
  default-language: Haskell2010

executable my-game-project-exe
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base >= 4.7 && < 5
                , my-game-project
                , megaparsec
  default-language: Haskell2010

executable my-game-project-gui
  hs-source-dirs: app
  main-is: Gui.hs
  build-depends: base >= 4.7 && < 5
                , my-game-project
                , gloss
  default-language: Haskell2010
  ghc-options: -threaded
  if !flag(gui)
    buildable: False

test-suite my-game-project-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: base >= 4.7 && < 5
               , my-game-project
               , hspec
               ,containers
               ,vector
  other-modules:
      GameSpec
      ,InputSpec
      ,MapSpec
      ,MovementSpec
      ,PlayerSpec
      ,UISpec
      ,CollisionSpec
      ,ItemSpec
      ,TerritorySpec
      ,TrailSpec
  default-language: Haskell2010
